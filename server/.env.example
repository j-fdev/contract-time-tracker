NODE_ENV=development

# Frontend URL allowed by CORS
ORIGIN=http://localhost:3000
APP_PORT=5000

# MongoDB: either a full URI, or a base URL + DB_NAME
MONGODB_URI=
MONGODB_URL=mongodb://localhost:27017
DB_NAME=contract_time_tracker_db
DB_SYNC=true

# Auth.js secret (at least 32 characters). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Admin account kept by "npm run seed:main" (everything else is replaced)
SEED_KEEP_EMAIL=
