NODE_ENV=development

# Frontend URL allowed by CORS
ORIGIN=http://localhost:3000
APP_PORT=5000

# MongoDB server address (MONGODB_URI, or MONGODB_URL), and the database to use.
# DB_NAME always decides the database, even if the URI contains one.
MONGODB_URI=
MONGODB_URL=mongodb://localhost:27017
DB_NAME=contract_time_tracker_db
DB_SYNC=true

# Auth.js secret (at least 32 characters). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Admin account kept by "npm run seed:main" (everything else is replaced)
SEED_KEEP_EMAIL=
